  "cross_table_business_rules": [
    {
      "id": "BR_ADM_BED_HOSP",
      "description": "Nếu ADMISSIONS.BED_ID có giá trị thì bệnh viện của BED -> ROOM -> DEPARTMENT phải bằng ADMISSIONS.HOSPITAL_ID.",
      "enforcement": "trigger_or_service_transaction"
    },
    {
      "id": "BR_ADM_REF_HOSP_PAT",
      "description": "Nếu ADMISSIONS.REFERRAL_ID khác NULL, ADMISSIONS.HOSPITAL_ID phải bằng REFERRALS.TO_HOSPITAL_ID và ADMISSIONS.PATIENT_ID phải bằng REFERRALS.PATIENT_ID.",
      "enforcement": "trigger_or_service_transaction"
    },
    {
      "id": "BR_APPT_DOC_DEPT",
      "description": "Nếu lịch hẹn có DOCTOR_ID, DOCTORS.DEPARTMENT_ID phải bằng APPOINTMENTS.DEPARTMENT_ID (hoặc thuộc bảng phân công nhiều khoa nếu mở rộng).",
      "enforcement": "trigger_or_service_transaction"
    },
    {
      "id": "BR_MEDREC_LINKS",
      "description": "MEDICAL_RECORDS.PATIENT_ID phải khớp PATIENT_ID của APPOINTMENTS/ADMISSIONS được trỏ tới; kiểm tra bác sĩ theo chính sách nghiệp vụ.",
      "enforcement": "trigger_or_service_transaction"
    },
    {
      "id": "BR_APPT_OVERLAP",
      "description": "UNIQUE(DOCTOR_ID,SCHEDULED_AT) chỉ chống trùng giờ bắt đầu; cần chống chồng lấn [SCHEDULED_AT, END_AT) cho lịch khám còn hiệu lực.",
      "enforcement": "service_transaction_with_locking"
    },
    {
      "id": "BR_ADM_HISTORY",
      "description": "Unique function-based index ngăn hai lượt ADMITTED giữ cùng BED_ID; nếu quản lý phân giường nhiều lần/lịch sử chuyển giường, bổ sung BED_ASSIGNMENTS với started_at/ended_at.",
      "enforcement": "oracle_unique_function_based_index_plus_service"
    },
    {
      "id": "BR_BEDS_STATUS",
      "description": "Trạng thái giường BEDS.STATUS và lượt nằm viện ADMISSIONS.STATUS phải đồng bộ trong cùng transaction; tránh cập nhật trạng thái thủ công lệch nhau.",
      "enforcement": "trigger_or_service_transaction"
    },
    {
      "id": "BR_RAG_VECTOR_DIMENSION",
      "description": "Với VECTOR(*, FLOAT32), ứng dụng phải kiểm tra đúng embedding model/dimension khi so sánh; chọn kích thước cố định và chỉ số vector khi model đã chốt.",
      "enforcement": "application_configuration"
    },
    {
      "id": "BR_ACCESS_CONTROL",
      "description": "Phân quyền theo bệnh viện/vai trò và ghi lại hoạt động xem/xuất dữ liệu y tế; JSON không thay thế RBAC và bảo mật.",
      "enforcement": "application_and_database_security"
    }
  ],
  "design_changes_vs_original_erd": [
    "ADMISSIONS thêm HOSPITAL_ID, ADMISSION_TYPE, ADMITTED_AT, REFERRAL_ID nullable, CREATED_AT; BED_ID nullable.",
    "ROOMS được bổ sung; BEDS thuộc ROOMS thay vì trực tiếp thuộc DEPARTMENTS.",
    "APPOINTMENTS bỏ UNIQUE riêng lẻ của SCHEDULED_AT/DOCTOR_ID; thay bằng UNIQUE (DOCTOR_ID, SCHEDULED_AT).",
    "MEDICAL_RECORDS bổ sung ADMISSION_ID để lưu bệnh án nội trú và ràng buộc tối thiểu một encounter.",
    "REFERRALS bổ sung bác sĩ chỉ định và thời gian tiếp nhận/hoàn tất.",
    "AUDIT_LOGS dùng JSON native cho OLD_DATA/NEW_DATA và lưu ACTOR_IDENTIFIER.",
    "MEDICAL_DOCUMENTS/SYMPTOM_KNOWLEDGE dùng VECTOR(*, FLOAT32) phù hợp Oracle 23ai."
  ],
  "limitations": [
    "Bản thiết kế không có bảng USER/ROLE, PRESCRIPTIONS, LAB_RESULTS, BED_ASSIGNMENTS; thêm khi mở rộng HIS thực tế.",
    "Tệp DDL chưa tạo trigger xuyên bảng; các luật BR_* cần triển khai ở service hoặc PL/SQL.",
    "Không thể trực tiếp tạo bảng Oracle bằng cách import tệp JSON đặc tả.",
    "Ví dụ status sử dụng mã tiếng Anh in hoa; ứng dụng cần nhất quán khi insert/update."
  ]
}
